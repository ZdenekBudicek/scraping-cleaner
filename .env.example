# Optional. Uploading files requires no AWS account.
# Prefer an AWS profile or IAM role to long-lived keys.
# Uncomment only the settings you use and fill them in locally.
# AWS_PROFILE=your-local-profile
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_DEFAULT_REGION=
# SCRAPING_CLEANER_S3_PATH=s3://your-bucket/your-prefix/
